* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# RFC822 fixtures are byte-sensitive: never normalize line endings.
*.eml -text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
