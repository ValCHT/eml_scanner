# Canonical environment variable names (docs/contracts.md §2.7).
# Copy to .env and fill only what you are authorized to use.
# NEVER commit .env. Secrets are SecretStr; absence is accepted at bootstrap.

# Runtime LLM — authorized derogation (user request): claude-haiku-4-5 on the
# OpenAI-compatible endpoint injected in the sandbox, instead of the Orange Luna
# proxy. If LITELLM_* are unset, load_settings maps OPENAI_API_KEY / OPENAI_BASE_URL
# from the sandbox environment. Secrets are SecretStr; absence is accepted.
LITELLM_CHAT_URL=https://www.genspark.ai/api/llm_proxy/v1/chat/completions
LITELLM_MODEL=claude-haiku-4-5
LITELLM_API_KEY=

# VirusTotal (GET lookups only; no upload, no execution)
VT_API_KEY=
VT_ACCESS_AUTHORIZED=false

# OpenCTI (read-only)
OPENCTI_URL=https://demo.opencti.io
OPENCTI_API_KEY=

# urlscan
URLSCAN_API_KEY=

# Feature switches
MODEL_SUPPORTS_VISION=false
RAG_ENABLED=false
QR_DECODE_ENABLED=false
LIVE_INTEGRATION=false

# Directories
RUNS_DIR=runs
CORPUS_DIR=corpus
CONFIG_DIR=configs
RAG_DIR=corpus/rag/chroma

# Budgets
MAX_EMAIL_SECONDS=240
INTERNAL_PHASE_SECONDS=60
FINAL_PHASE_SECONDS=90
INTERNAL_MAX_OUTPUT_TOKENS=8192
FINAL_MAX_OUTPUT_TOKENS=16384
MAX_LLM_ATTEMPTS=2

# Live smoke references (public/approved artifacts only; optional)
LIVE_VT_KNOWN_SHA256=
LIVE_CTI_KNOWN_VALUE=
LIVE_CTI_KNOWN_TYPE=
LIVE_BENIGN_URL=
LIVE_REDIRECT_URL=
